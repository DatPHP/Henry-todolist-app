generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Todo {
  id        String   @id @default(cuid())
  content   String
  date      DateTime
  status    String   @default("not_completed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}